#!/usr/bin/env bash
# Fleetwatch agent installer, generated by ops-server.
# Usage: curl -fsSL {{.URL}}/install.sh | sudo bash -s -- <enrollment-token>
# Re-running it upgrades the binary and re-pairs the server with a new token.
# Remove the agent again with: curl -fsSL {{.URL}}/uninstall.sh | sudo bash
set -euo pipefail

SERVER_URL={{shellquote .URL}}
TOKEN="${1:-}"

die() { echo "error: $*" >&2; exit 1; }
[ -n "$TOKEN" ] || die "missing enrollment token (usage: install.sh <token>)"
[ "$(id -u)" -eq 0 ] || die "run as root (pipe into 'sudo bash')"
command -v systemctl >/dev/null || die "systemd is required"
command -v sha256sum >/dev/null || die "sha256sum is required"

case "$(uname -m)" in
  x86_64 | amd64) ARCH=amd64 ;;
  aarch64 | arm64) ARCH=arm64 ;;
  *) die "unsupported architecture $(uname -m)" ;;
esac

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

echo "Downloading ops-agent (linux-$ARCH) from $SERVER_URL"
curl -fsSL "$SERVER_URL/agent/download/linux-$ARCH" -o "$TMP/ops-agent"
curl -fsSL "$SERVER_URL/agent/download/linux-$ARCH.sha256" -o "$TMP/sum"
echo "$(cat "$TMP/sum")  $TMP/ops-agent" | sha256sum --check --quiet - || die "checksum mismatch, download corrupted"

install -m 0755 "$TMP/ops-agent" /usr/local/bin/ops-agent
install -d -m 0700 /etc/ops-agent
/usr/local/bin/ops-agent enroll --server "$SERVER_URL" --token "$TOKEN"

cat > /etc/systemd/system/ops-agent.service <<'UNIT'
{{.Unit}}UNIT

systemctl daemon-reload
systemctl enable ops-agent >/dev/null 2>&1
systemctl restart ops-agent
echo "ops-agent is installed and running. Check it with: systemctl status ops-agent"
